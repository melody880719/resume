<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>melody作品集</title>
<meta name="description" content="十五年市场营销与品牌传播，六年以上高星酒店市场传讯负责人。抖音自播全年 GMV 300 万，达人矩阵操盘，全域内容运营。履历、作品、影像与荣誉全览。">
<meta property="og:title" content="melody作品集">
<meta property="og:description" content="十五年酒店与地产营销传播，作品在三亚。">
<meta property="og:type" content="profile">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='4' fill='%23A8402F'/%3E%3Ctext x='32' y='44' font-family='Georgia, serif' font-size='36' fill='%23FAF7F2' text-anchor='middle'%3E%E8%9E%8D%3C/text%3E%3C/svg%3E">
<style>
  :root {
    --bg: #0e0f13; --bg-soft: #15161c; --panel: #1a1b22; --panel-2: #202128;
    --line: rgba(255,255,255,0.08); --gold: #c9a86a; --gold-soft: rgba(201,168,106,0.14);
    --text: #ece8e1; --text-dim: #9a968e; --text-faint: #6d6a64;
    --paper: #FAF7F2; --ink: #22201d; --ink-soft: #5c5852; --ink-faint: #8d8880; --accent: #A8402F;
    --serif: "Noto Serif SC", "Songti SC", Georgia, serif;
    --sans: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { background: var(--bg); color: var(--text); font-family: var(--sans); line-height: 1.7; -webkit-font-smoothing: antialiased; }
  ::selection { background: var(--gold-soft); }
  img { display: block; max-width: 100%; }

  /* ========== 封面：沿用原站轮动图带版本 ========== */
  body.cover-lock { overflow: hidden; }
  .cover {
    position: fixed; inset: 0; z-index: 300;
    display: flex; flex-direction: column; padding: 0;
    background: var(--paper);
  }
  .cover-band { height: 24vh; overflow: hidden; }
  .cover-track {
    display: flex; gap: 16px; padding-right: 16px;
    width: max-content; height: 100%;
    animation: cover-marquee 70s linear infinite; will-change: transform;
  }
  .cover-band--bottom .cover-track { animation-duration: 80s; animation-direction: reverse; }
  .cover-track img { height: 100%; width: auto; flex: none; display: block; }
  @keyframes cover-marquee { to { transform: translateX(-25%); } }
  .cover__mid {
    flex: 1 1 auto; min-height: 52vh;
    display: flex; align-items: center; justify-content: center;
    border-top: 1px solid rgba(34,32,29,0.16); border-bottom: 1px solid rgba(34,32,29,0.16);
    background: var(--paper);
  }
  .cover__inner { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 28px 20px; }
  .cover__name {
    font-family: Georgia, var(--serif); font-size: clamp(40px, 8vw, 96px);
    line-height: 1.1; font-weight: 600; letter-spacing: 0.02em; color: var(--ink);
    animation: cover-in 400ms ease backwards;
  }
  .cover-tagline { margin-top: 16px; font-size: 16px; line-height: 1.8; color: var(--ink-soft); }
  .cover-tagline__dot { color: var(--accent); font-style: normal; padding: 0 4px; }
  .cover__gate {
    margin-top: 40px; appearance: none; background: transparent; color: var(--ink);
    border: 1px solid rgba(34,32,29,0.35); border-radius: 2px; height: 48px; padding: 0 32px;
    font-family: var(--sans); font-size: 15px; font-weight: 500; letter-spacing: 0.08em; cursor: pointer;
    animation: cover-in 400ms ease 120ms backwards; transition: border-color .25s;
  }
  .cover__gate:hover { border-color: var(--ink); }
  @keyframes cover-in { from { transform: translateY(16px); } }
  .cover.revealing, .cover.revealing .cover__inner { transition: transform 600ms ease; }
  .cover.revealing { transform: translateY(-100%); }
  .cover.revealing .cover__inner { transform: translateY(-32%); }
  @media (max-width: 767px) {
    .cover-band { height: 16vh; }
    .cover-track { animation-duration: 50s; }
    .cover-band--bottom .cover-track { animation-duration: 55s; }
    .cover__gate { width: min(100%, 280px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover-track, .cover__name, .cover__gate { animation: none; }
    .cover.revealing, .cover.revealing .cover__inner { transition: none; }
  }

  /* ========== 导航 ========== */
  nav.top {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 6vw; background: rgba(14,15,19,0.8);
    backdrop-filter: blur(12px); border-bottom: 1px solid var(--line);
    opacity: 0; pointer-events: none; transition: opacity .5s;
  }
  body.cover-open nav.top { opacity: 1; pointer-events: auto; }
  .nav-logo { font-family: var(--serif); font-size: 17px; letter-spacing: 3px; color: var(--gold); text-decoration: none; }
  .nav-links { display: flex; gap: 26px; flex-wrap: wrap; }
  .nav-links a { color: var(--text-dim); text-decoration: none; font-size: 13px; letter-spacing: 2px; transition: color .3s; }
  .nav-links a:hover { color: var(--gold); }
  #lang-toggle { border: 1px solid var(--gold); background: none; color: var(--gold); font-size: 12px; letter-spacing: 2px; padding: 5px 12px; cursor: pointer; border-radius: 2px; font-family: var(--sans); transition: background .3s; }
  #lang-toggle:hover { background: var(--gold-soft); }
  @media (max-width: 640px) { .nav-links { gap: 12px; } .nav-links a { font-size: 11px; letter-spacing: 1px; } }

  /* ========== Hero ========== */
  .hero { min-height: 100vh; display: flex; align-items: center; padding: 130px 6vw 90px; position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; top: -20%; right: -8%;
    width: 55vw; height: 55vw; max-width: 700px; max-height: 700px;
    background: radial-gradient(circle, rgba(201,168,106,0.10) 0%, transparent 65%); pointer-events: none;
  }
  .hero-grid { display: grid; grid-template-columns: 1.35fr .65fr; gap: 56px; align-items: center; width: 100%; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .hero-portrait { max-width: 300px; } }
  .hero-kicker { color: var(--gold); font-size: 13px; letter-spacing: 6px; margin-bottom: 22px; font-weight: 500; }
  .hero h1 { font-family: var(--serif); font-size: clamp(40px, 6.4vw, 76px); font-weight: 600; letter-spacing: 5px; line-height: 1.3; }
  .hero h1 .thin { color: var(--text-dim); font-weight: 300; }
  .hero-name { margin-top: 18px; font-size: 17px; letter-spacing: 3px; }
  .hero-name small { color: var(--text-faint); letter-spacing: 2px; font-weight: 400; }
  .hero-tags { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-tags span { border: 1px solid var(--line); border-radius: 999px; padding: 6px 16px; font-size: 12.5px; color: var(--text-dim); letter-spacing: 1px; }
  .hero-cta { margin-top: 42px; display: flex; gap: 18px; flex-wrap: wrap; }
  .btn { text-decoration: none; padding: 13px 32px; font-size: 14px; letter-spacing: 3px; border-radius: 2px; transition: all .3s; display: inline-block; cursor: pointer; background: none; font-family: var(--sans); }
  .btn-gold { background: var(--gold); color: #14100a; border: 1px solid var(--gold); }
  .btn-gold:hover { background: transparent; color: var(--gold); }
  .btn-ghost { border: 1px solid var(--line); color: var(--text-dim); }
  .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }
  .hero-portrait { position: relative; }
  .hero-portrait img { width: 100%; border: 1px solid var(--line); }
  .hero-portrait::after { content: ""; position: absolute; inset: 14px -14px -14px 14px; border: 1px solid rgba(201,168,106,0.35); z-index: -1; }

  /* ========== 区块通用 ========== */
  section { padding: 100px 6vw; border-top: 1px solid var(--line); }
  .sec-head { margin-bottom: 52px; }
  .sec-index { color: var(--gold); font-size: 12px; letter-spacing: 4px; display: block; margin-bottom: 14px; }
  .sec-title { font-family: var(--serif); font-size: clamp(28px, 4vw, 38px); font-weight: 600; letter-spacing: 4px; }
  .sec-line { width: 56px; height: 1px; background: var(--gold); margin-top: 22px; opacity: .6; }

  /* ========== 数据 ========== */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .stat { background: var(--bg-soft); padding: 32px 18px; text-align: center; }
  .stat-num { font-family: var(--serif); font-size: clamp(22px, 3.0vw, 36px); color: var(--gold); font-weight: 600; letter-spacing: 1px; }
  .stat-label { margin-top: 10px; color: var(--text-dim); font-size: 12.5px; letter-spacing: 2px; }
  @media (max-width: 760px) { .stats { grid-template-columns: repeat(2, 1fr); } }

  /* ========== 关于 ========== */
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }
  .about-text p { color: var(--text-dim); font-size: 15px; margin-bottom: 20px; }
  .about-text strong { color: var(--text); font-weight: 500; }
  .about-card { background: var(--panel); border: 1px solid var(--line); padding: 32px 28px; }
  .about-card h3 { font-family: var(--serif); font-size: 16px; color: var(--gold); letter-spacing: 3px; margin-bottom: 18px; font-weight: 500; }
  .about-card ul { list-style: none; }
  .about-card li { color: var(--text-dim); font-size: 13.5px; padding: 8px 0; border-bottom: 1px dashed var(--line); letter-spacing: 1px; }
  .about-card li:last-child { border-bottom: none; }

  /* ========== 时间线 ========== */
  .timeline { position: relative; margin-left: 8px; }
  .timeline::before { content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 1px; background: linear-gradient(var(--gold), var(--line)); }
  .t-item { position: relative; padding: 0 0 46px 34px; }
  .t-item:last-child { padding-bottom: 0; }
  .t-item::before { content: ""; position: absolute; left: -5px; top: 8px; width: 11px; height: 11px; background: var(--bg); border: 1px solid var(--gold); transform: rotate(45deg); }
  .t-time { color: var(--gold); font-size: 13px; letter-spacing: 3px; }
  .t-role { font-family: var(--serif); font-size: 20px; letter-spacing: 2px; margin: 10px 0 4px; font-weight: 600; }
  .t-org { color: var(--text-dim); font-size: 14px; letter-spacing: 1px; margin-bottom: 14px; }
  .t-desc { color: var(--text-dim); font-size: 14px; max-width: 760px; }
  .t-desc li { margin-left: 18px; margin-bottom: 6px; }
  .t-desc li b { color: var(--text); font-weight: 500; }
  .t-compact { position: relative; padding: 6px 0 0 34px; color: var(--text-faint); font-size: 13px; letter-spacing: 1px; }
  .t-compact::before { content: ""; position: absolute; left: -2px; top: 14px; width: 5px; height: 5px; background: var(--text-faint); transform: rotate(45deg); }

  /* ========== 能力 ========== */
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 900px) { .skills { grid-template-columns: 1fr; } }
  .skill { background: var(--panel); border: 1px solid var(--line); padding: 28px 26px; transition: border-color .3s, transform .3s; }
  .skill:hover { border-color: rgba(201,168,106,0.45); transform: translateY(-3px); }
  .skill-num { color: var(--text-faint); font-size: 12px; letter-spacing: 3px; }
  .skill h3 { font-family: var(--serif); font-size: 17px; letter-spacing: 2px; margin: 10px 0 10px; font-weight: 500; }
  .skill p { color: var(--text-dim); font-size: 13.5px; }

  /* ========== 作品筛选 ========== */
  .filter-bar { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 36px; }
  .filter-btn { border: 1px solid var(--line); background: none; color: var(--text-dim); padding: 8px 20px; font-size: 13px; letter-spacing: 2px; cursor: pointer; transition: all .3s; font-family: var(--sans); }
  .filter-btn .f-count { color: var(--text-faint); font-size: 11px; margin-left: 6px; }
  .filter-btn[aria-pressed="true"] { border-color: var(--gold); color: var(--gold); background: var(--gold-soft); }

  /* ========== 分组缩略图 ========== */
  .wgroup { margin-bottom: 48px; }
  .wgroup .group-head { margin: 0 0 16px; }
  .mini-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 12px; }
  @media (max-width: 620px) { .mini-grid { grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 9px; } }
  .mini { margin: 0; cursor: pointer; overflow: hidden; background: var(--panel); border: 1px solid var(--line); transition: border-color .3s, transform .3s, box-shadow .3s; }
  .mini:hover { border-color: rgba(201,168,106,0.55); transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,0.35); }
  .mini img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; transition: transform .45s ease; }
  .mini:hover img { transform: scale(1.05); }
  .mini figcaption { padding: 7px 9px; font-size: 11px; color: var(--text-dim); letter-spacing: 1.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-top: 1px solid var(--line); }
  .wc-body { padding: 14px 16px 16px; }
  .wc-title { display: block; color: var(--text); font-size: 14.5px; letter-spacing: 1px; }
  .wc-meta { display: block; color: var(--text-faint); font-size: 12px; margin-top: 3px; letter-spacing: 1px; }
  .wc-cat { display: inline-block; color: var(--gold); font-size: 11px; letter-spacing: 2px; margin-bottom: 6px; }
  .works-note { margin-top: 22px; color: var(--text-faint); font-size: 13px; letter-spacing: 1px; border-left: 2px solid var(--gold); padding-left: 14px; }

  /* ========== 特写 ========== */
  .featured-split { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; margin-bottom: 56px; }
  @media (max-width: 860px) { .featured-split { grid-template-columns: 1fr; } }
  .featured-media img { width: 100%; border: 1px solid var(--line); cursor: pointer; }
  .featured-note .case-no { color: var(--gold); font-size: 11px; letter-spacing: 4px; margin-bottom: 14px; }
  .featured-note h3 { font-family: var(--serif); font-size: 26px; letter-spacing: 2px; font-weight: 600; margin-bottom: 14px; }
  .featured-note p { color: var(--text-dim); font-size: 14.5px; max-width: 480px; }
  .featured-note .case-src { margin-top: 14px; color: var(--text-faint); font-size: 12.5px; letter-spacing: 1px; }

  /* ========== 影像 ========== */
  .film-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 34px; }
  @media (max-width: 900px) { .film-row { grid-template-columns: 1fr; } }
  .video-card { background: var(--panel); border: 1px solid var(--line); overflow: hidden; transition: border-color .3s; }
  .video-card:hover { border-color: rgba(201,168,106,0.45); }
  .video-card.cinema { grid-column: 1 / -1; margin-bottom: 34px; }
  .video-media { position: relative; display: flex; align-items: center; justify-content: center; background: var(--panel-2); min-height: 220px; }
  .video-media img { max-height: 420px; width: auto; max-width: 100%; }
  .video-card.cinema .video-media img { max-height: 520px; width: 100%; object-fit: cover; }
  .play-btn { position: absolute; inset: 0; margin: auto; width: 58px; height: 58px; border-radius: 50%; background: rgba(14,15,19,0.65); border: 1px solid var(--gold); color: var(--gold); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background .3s; }
  .play-btn svg { width: 22px; height: 22px; margin-left: 3px; }
  .play-btn:hover { background: rgba(201,168,106,0.25); }
  .dur-badge { position: absolute; right: 12px; bottom: 12px; background: rgba(14,15,19,0.8); border: 1px solid var(--line); color: var(--text-dim); font-size: 11px; padding: 3px 10px; letter-spacing: 1px; }
  .video-caption { padding: 14px 16px 16px; }
  .video-card video { width: 100%; display: block; background: #000; }
  .group-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin: 40px 0 22px; flex-wrap: wrap; }
  .group-head h3 { font-family: var(--serif); font-size: 20px; letter-spacing: 2px; font-weight: 500; }
  .group-count { color: var(--text-faint); font-size: 12.5px; letter-spacing: 1px; }

  /* ========== 荣誉 ========== */
  .awards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 36px; }
  @media (max-width: 900px) { .awards { grid-template-columns: repeat(2, 1fr); } }
  .award { background: var(--panel); border: 1px solid var(--line); padding: 16px; }
  .award img { width: 100%; }
  .award figcaption { color: var(--text-dim); font-size: 12.5px; margin-top: 10px; letter-spacing: 1px; text-align: center; }
  .honor-list { list-style: none; }
  .honor-item { padding: 16px 0; border-bottom: 1px dashed var(--line); }
  .honor-item:last-child { border-bottom: none; }
  .honor-name { font-size: 15px; font-weight: 500; letter-spacing: 1px; }
  .honor-meta { color: var(--text-faint); font-size: 12.5px; margin-top: 4px; letter-spacing: 1px; }

  /* ========== 联系 ========== */
  .contact { text-align: center; }
  .contact .sec-line { margin-left: auto; margin-right: auto; }
  .contact-lead { font-family: var(--serif); font-size: clamp(22px, 3.4vw, 30px); letter-spacing: 4px; font-weight: 500; margin-bottom: 36px; }
  .contact-list { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-bottom: 40px; }
  .contact-item { display: flex; align-items: center; gap: 12px; background: var(--panel); border: 1px solid var(--line); padding: 13px 24px; color: var(--text-dim); font-size: 14px; letter-spacing: 1px; text-decoration: none; transition: border-color .3s, color .3s; }
  a.contact-item:hover { border-color: var(--gold); color: var(--gold); }
  .contact-item b { color: var(--text-faint); font-weight: 400; font-size: 12px; letter-spacing: 2px; }

  footer { border-top: 1px solid var(--line); padding: 30px 6vw; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; color: var(--text-faint); font-size: 12px; letter-spacing: 2px; }

  /* ========== 灯箱 ========== */
  dialog.lightbox { border: none; background: rgba(10,10,13,0.96); padding: 0; max-width: 92vw; max-height: 92vh; }
  dialog.lightbox::backdrop { background: rgba(0,0,0,0.85); }
  .lb-img { max-width: 92vw; max-height: 84vh; object-fit: contain; }
  .lb-bar { display: flex; gap: 16px; padding: 12px 18px; color: var(--text-dim); font-size: 13px; letter-spacing: 1px; align-items: baseline; }
  .lb-title { color: var(--text); }
  .lb-close { position: fixed; top: 18px; right: 22px; background: none; border: 1px solid var(--line); color: var(--text-dim); width: 42px; height: 42px; cursor: pointer; font-size: 18px; }
  .lb-close:hover { color: var(--gold); border-color: var(--gold); }

  .reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s ease; }
  .reveal.on { opacity: 1; transform: none; }
</style>
</head>
<body class="cover-lock">

<!-- ========== 封面：轮动图带（沿用原站版本） ========== -->
<div class="cover" id="cover">
  <div class="cover-band cover-band--top" aria-hidden="true">
    <div class="cover-track">
      <img src="assets/img/conifer-xiaoshu-s.jpg" alt=""><img src="assets/img/palace-blue-because-love-you-s.jpg" alt=""><img src="assets/img/social-this-is-my-holiday-s.jpg" alt=""><img src="assets/img/huayu-qixi-s.jpg" alt=""><img src="assets/img/photo-pool-portrait-s.jpg" alt=""><img src="assets/img/primus-fresh-air-s.jpg" alt=""><img src="assets/img/huayu-valentines-la-floret-s.jpg" alt="">
      <img src="assets/img/conifer-xiaoshu-s.jpg" alt=""><img src="assets/img/palace-blue-because-love-you-s.jpg" alt=""><img src="assets/img/social-this-is-my-holiday-s.jpg" alt=""><img src="assets/img/huayu-qixi-s.jpg" alt=""><img src="assets/img/photo-pool-portrait-s.jpg" alt=""><img src="assets/img/primus-fresh-air-s.jpg" alt=""><img src="assets/img/huayu-valentines-la-floret-s.jpg" alt="">
      <img src="assets/img/conifer-xiaoshu-s.jpg" alt=""><img src="assets/img/palace-blue-because-love-you-s.jpg" alt=""><img src="assets/img/social-this-is-my-holiday-s.jpg" alt=""><img src="assets/img/huayu-qixi-s.jpg" alt=""><img src="assets/img/photo-pool-portrait-s.jpg" alt=""><img src="assets/img/primus-fresh-air-s.jpg" alt=""><img src="assets/img/huayu-valentines-la-floret-s.jpg" alt="">
      <img src="assets/img/conifer-xiaoshu-s.jpg" alt=""><img src="assets/img/palace-blue-because-love-you-s.jpg" alt=""><img src="assets/img/social-this-is-my-holiday-s.jpg" alt=""><img src="assets/img/huayu-qixi-s.jpg" alt=""><img src="assets/img/photo-pool-portrait-s.jpg" alt=""><img src="assets/img/primus-fresh-air-s.jpg" alt=""><img src="assets/img/huayu-valentines-la-floret-s.jpg" alt="">
    </div>
  </div>
  <div class="cover__mid">
    <div class="cover__inner">
      <h1 class="cover__name">Melody Lu</h1>
      <p class="cover-tagline">AI 运用 <i class="cover-tagline__dot">·</i> 品牌调性 <i class="cover-tagline__dot">·</i> 审美 <i class="cover-tagline__dot">·</i> 文字表达 <i class="cover-tagline__dot">·</i> 自媒体运营</p>
      <button class="cover__gate" id="enter" type="button" aria-label="进入站点">进入</button>
    </div>
  </div>
