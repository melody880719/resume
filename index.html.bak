<!-- ========== 灯箱 ========== -->
<dialog class="lightbox" id="lightbox">
  <img class="lb-img" src="" alt="">
  <div class="lb-bar"><span class="lb-title"></span><span class="lb-meta"></span></div>
  <button class="lb-close" type="button" aria-label="关闭">✕</button>
</dialog>

<script>
  // 封面揭幕
  const cover = document.getElementById('cover');
  function enter() {
    if (cover.classList.contains('revealing')) return;
    cover.classList.add('revealing');
    document.body.classList.remove('cover-lock');
    document.body.classList.add('cover-open');
    setTimeout(() => cover.remove(), 650);
  }
  document.getElementById('enter').addEventListener('click', enter);

  // 滚动浮现
  const io = new IntersectionObserver((es) => {
    es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // 作品筛选
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const f = btn.dataset.filter;
      document.querySelectorAll('.wgroup').forEach(g => {
        g.style.display = (f === 'all' || g.dataset.cat === f) ? '' : 'none';
      });
    });
  });

  // 灯箱
  const lb = document.getElementById('lightbox');
  const lbImg = lb.querySelector('.lb-img');
  const lbTitle = lb.querySelector('.lb-title');
  const lbMeta = lb.querySelector('.lb-meta');
  function openLb(el) {
    const img = el.tagName === 'IMG' ? el : el.querySelector('img');
    if (!img) return;
    lbImg.src = el.dataset.lbSrc || img.dataset.lbSrc || img.src;
    lbImg.alt = img.alt || '';
    const t = el.querySelector ? el.querySelector('.wc-title') : null;
    const m = el.querySelector ? el.querySelector('.wc-meta') : null;
    lbTitle.textContent = (lang === 'en' && el.dataset.lbTitleEn) ? el.dataset.lbTitleEn : (el.dataset.lbTitle || (t ? t.textContent : '') || img.alt || '');
    lbMeta.textContent = (lang === 'en' && el.dataset.lbMetaEn) ? el.dataset.lbMetaEn : (el.dataset.lbMeta || (m ? m.textContent : ''));
    if (typeof lb.showModal === 'function') lb.showModal(); else lb.setAttribute('open', '');
  }
  document.querySelectorAll('.mini').forEach(c => c.addEventListener('click', () => openLb(c)));
  lb.querySelector('.lb-close').addEventListener('click', () => lb.close());
  lb.addEventListener('click', e => { if (e.target === lb) lb.close(); });

  // 中英切换
  let lang = 'zh';
  const langStore = new Map();
  document.getElementById('lang-toggle').addEventListener('click', () => {
    lang = lang === 'zh' ? 'en' : 'zh';
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
    document.querySelectorAll('[data-en]').forEach(el => {
      if (!langStore.has(el)) langStore.set(el, el.innerHTML);
      el.innerHTML = lang === 'en' ? el.dataset.en : langStore.get(el);
    });
    document.getElementById('lang-toggle').textContent = lang === 'zh' ? 'EN' : '中文';
  });

  // 视频点击即播
  document.querySelectorAll('.video-card').forEach(card => {
    const btn = card.querySelector('.play-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const media = card.querySelector('.video-media');
      const src = card.dataset.videoSrc;
      if (!src) return;
      media.innerHTML = '<video src="' + src + '" controls autoplay playsinline preload="metadata"></video>';
    });
  });
</script>

</body>
</html>
